set(PARTNO atmega328p)
set(F_CPU 16000000)
set(CMAKE_C_COMPILER avr-gcc)
set(CMAKE_C_FLAGS "-mmcu=${PARTNO} -Wall -DF_CPU=${F_CPU} -Os -Wl,-Map=bin/${PROJECT_NAME}.map")
set(CMAKE_EXECUTABLE_SUFFIX ".elf")
set(AVROBJ avr-objcopy)
set(AVROBJ_FLAGS -O ihex -j .text -j .data)
set(CONFIG arduino)
set(AVR_DUDE avrdude)
set(AVR_DUDE_CONF /etc/avrdude.conf)
set(PORT /dev/ttyACM0)
set(BAUD_RATE 115200)
set(AVR_DUDE_FLAGS -p ${PARTNO} -c ${CONFIG} -P ${PORT} -b ${BAUD_RATE} -C ${AVR_DUDE_CONF} -D -U)
